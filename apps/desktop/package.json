{
  "name": "@spicebench/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pack": "electron-builder --dir -c electron-builder.json",
    "dist": "electron-builder -c electron-builder.json",
    "dist:mac": "electron-builder --mac -c electron-builder.json",
    "dist:win": "electron-builder --win -c electron-builder.json"
  },
  "dependencies": {
    "98.css": "^0.1.20",
    "@spicebench/core": "workspace:*",
    "@spicebench/mcp": "workspace:*",
    "@spicebench/sim": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
